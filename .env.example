# 환경 변수 이름과 비밀이 아닌 팀 설정만 적는다. 키와 로그인 정보는 적지 않는다.
# 이 파일을 .env 로 복사하면 팀 설정 그대로 돈다. .env 는 깃에 올라가지 않는다.
#
#   Copy-Item .env.example .env
#
# 팀은 각자의 Claude 구독으로 LLM 을 부른다 (11-17, CLAUDE.md 의 "스택"). API 키는 쓰지 않는다.
# 엔진이 공식 Claude Code 명령 claude -p 를 부르므로, 터미널에서 claude auth login 을 한 번 해 둔다 (README 의 "시뮬레이션을 돌린다").
# 로그인하지 않아도 저장된 응답으로 화면은 돌아간다.
#
# 키 없이 예시 사본을 재생할 때는 README 의 "시뮬레이션을 돌린다"를 따른다 (예시의 답은 다른 공급자로 받은 것이다).
# 변수 위 줄 끝의 괄호는 비워 둘 때 엔진이 쓰는 값이다. 엔진의 기본값은 예시 묶음의 저장된 답을 받은 공급자라서 팀 설정과 다르다.

# LLM 공급자. 쓸 수 있는 값: anthropic, openai-compatible, claude-code. 팀은 claude-code 다. 비워 두면 (anthropic)
LLM_PROVIDER=claude-code

# 모델 이름. 팀이 정한 모델 하나를 모두 같이 쓴다. 11-17 에 정했고 보정이 끝날 때까지 바꾸지 않는다. docs/PROGRESS.md 의 T114.
# 모두 같은 모델이어야 저장된 답을 서로 재생하고 보정이 맞는다. 비워 두면 (claude-opus-5-5)
LLM_MODEL=claude-opus-5-5

# 실행 한 번에 LLM 을 새로 부를 수 있는 횟수의 상한 (200)
LLM_CALL_LIMIT=

# claude 명령이 PATH 에 있으면 비워 둔다. 데스크톱 앱에 든 것을 쓰면 그 claude.exe 의 경로를 적는다 (앱이 업데이트되면 경로가 바뀐다)
CLAUDE_CODE_PATH=

# ── 아래는 팀 설정이 아니다. 다른 공급자로 따로 돌려 볼 때만 쓴다. 그 답은 보정과 시연에 쓰지 않는다 ──
# 공급자나 모델이 다르면 요청의 해시가 달라 팀이 받은 답과 서로 재생되지 않는다.

# 공급자가 openai-compatible 일 때만 쓴다. OpenAI 의 chat completions 와 같은 모양으로 받는 주소이고 /chat/completions 앞까지 https:// 로 적는다.
# http:// 는 이 PC 의 주소 localhost, 127.0.0.1, ::1 일 때만 받는다
LLM_BASE_URL=https://api.openai.com/v1

# 공급자가 openai-compatible 일 때만 쓴다. 자기 API 키를 넣는다. 키 없이 받는 로컬 주소면 비워 둔다
LLM_API_KEY=

# 공급자가 openai-compatible 일 때 답의 모양을 묶는 방식. json_schema 는 이 요청에서 고를 수 있는 값만 받는 스키마를 보낸다.
# 스키마를 받지 않는 주소면 json_object 로 적는다. 일부 로컬 모델이 그렇다.
# 비워 두면 (json_schema)
LLM_RESPONSE_FORMAT=

# 공급자가 anthropic 일 때만 쓴다. Anthropic API 키다
ANTHROPIC_API_KEY=

# 화면의 AI 메뉴가 읽는 모델 이름이다 (app/, T202). 엔진은 읽지 않는다.
# CLAUDE_MODEL 은 비워 두면 위의 LLM_MODEL 을 쓴다. 팀 설정에서는 비워 둔다.
# OPENAI_MODEL 은 화면에서 OpenAI 로 따로 돌려 볼 때만 적는다
CLAUDE_MODEL=
OPENAI_MODEL=
