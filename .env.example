# 환경 변수 이름만 적는다. 값은 각자 PC 의 .env 에만 둔다.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 깃에 올라가지 않는다.
#
#   Copy-Item .env.example .env
#
# 키는 각자 발급한다. 서로 주고받지 않는다 (docs/PRD.md 13절).
# 키가 없어도 저장된 응답으로 화면은 돌아간다.

# Anthropic API 키. LLM 을 실제로 부를 때만 필요하다.
ANTHROPIC_API_KEY=

# 아래는 바꾸고 싶을 때만 적는다. 적지 않으면 괄호 안의 값을 쓴다.

# LLM 공급자 (anthropic)
LLM_PROVIDER=

# 모델 이름 (claude-opus-5-5)
LLM_MODEL=

# 실행 한 번에 LLM 을 새로 부를 수 있는 횟수의 상한 (200)
LLM_CALL_LIMIT=
