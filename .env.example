# 환경 변수 이름과 비밀이 아닌 팀 설정만 적는다. 키는 각자 PC 의 .env 에만 둔다.
# 이 파일을 .env 로 복사한 뒤 키와 모델을 채운다. .env 는 깃에 올라가지 않는다.
#
#   Copy-Item .env.example .env
#
# 키는 각자 발급한다. 서로 주고받지 않는다 (docs/PRD.md 13절).
# 키가 없어도 저장된 응답으로 화면은 돌아간다.
#
# 팀은 OpenAI API 를 쓴다 (11-16, CLAUDE.md 의 "스택"). LLM_PROVIDER 와 LLM_BASE_URL 은 적힌 그대로 둔다.
# 키 없이 예시 사본을 재생할 때는 README 의 "시뮬레이션을 돌린다"를 따른다 (예시의 답은 다른 공급자로 받은 것이다).
# 변수 위 줄 끝의 괄호는 비워 둘 때 엔진이 쓰는 값이다. 엔진의 기본값은 예시 묶음의 저장된 답을 받은 공급자라서 팀 설정과 다르다.

# LLM 공급자. 쓸 수 있는 값: anthropic, openai-compatible, claude-code. 비워 두면 (anthropic)
LLM_PROVIDER=openai-compatible

# OpenAI 의 chat completions 와 같은 모양으로 받는 주소. /chat/completions 앞까지 https:// 로 적는다.
# http:// 는 이 PC 의 주소 localhost, 127.0.0.1, ::1 일 때만 받는다. 공급자가 openai-compatible 일 때만 쓴다
LLM_BASE_URL=https://api.openai.com/v1

# OpenAI API 키. 자기 키를 넣는다. 키 없이 받는 로컬 주소면 비워 둔다
LLM_API_KEY=

# 모델 이름. 팀이 정한 날짜가 붙은 판 하나를 적는다 (11-17 에 정한다. docs/PROGRESS.md 의 T103).
# 모두 같은 모델이어야 저장된 답을 서로 재생하고 보정이 맞는다. openai-compatible 이면 꼭 적는다. 비워 두면 (claude-opus-5-5)
LLM_MODEL=

# 실행 한 번에 LLM 을 새로 부를 수 있는 횟수의 상한 (200)
LLM_CALL_LIMIT=

# 답의 모양을 묶는 방식. json_schema 는 이 요청에서 고를 수 있는 값만 받는 스키마를 보낸다.
# 스키마를 받지 않는 주소면 json_object 로 적는다 (일부 로컬 모델이 그렇다).
# 비워 두면 (json_schema)
LLM_RESPONSE_FORMAT=

# Anthropic 을 쓸 때만 적는다 (팀은 쓰지 않는다)
ANTHROPIC_API_KEY=

# 자기 Claude 구독으로 개인 연습할 때만 쓴다 (T104). 시연과 보정에는 쓰지 않는다 (팀은 OpenAI).
# 로컬에서 시험할 때는 이 공급자로 먼저 돌린다 (T106, README 의 "시뮬레이션을 돌린다").
# LLM_PROVIDER=claude-code, LLM_MODEL 에 Claude 모델(예: claude-sonnet-5-5)을 적고, 터미널에서 claude auth login 을 한 번 한다.
# claude 명령이 PATH 에 있으면 비워 둔다. 데스크톱 앱에 든 것을 쓰면 그 claude.exe 의 경로를 적는다 (앱이 업데이트되면 경로가 바뀐다)
CLAUDE_CODE_PATH=
