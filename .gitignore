# 비밀값 — 절대 올리지 않는다
.env
.env.*
!.env.example

# 내부 자료 — 안내 파일만 빼고 모두 무시한다
private/*
!private/README.md

# 화면의 간편 시뮬레이터가 만든 상황 파일 (T202). 시연에 쓸 상황은 사람이 확정해 ui- 없이 올린다
scenarios/ui-*.json
# 가상 예시 값으로 돌린 실행 폴더 모두. 각자 연습으로 돌린 답이 올라가지 않게 한다 (11-16, T107).
# 맨 위의 engine/ 에만 걸린다. 테스트의 예시 묶음(tests/fixtures/<이름>/engine/samples/runs/)은 올린다
engine/samples/runs/*/

# 운영체제·편집기
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# AI 도구의 개인 상태
.omc/
.claude/settings.local.json

# 생성물 (Python + uv)
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
