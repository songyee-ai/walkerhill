# 비밀값 — 절대 올리지 않는다
.env
.env.*
!.env.example

# 내부 자료 — 안내 파일만 빼고 모두 무시한다
private/*
!private/README.md

# 화면의 간편 시뮬레이터가 만든 상황 파일 (T202). 시연에 쓸 상황은 사람이 확정해 ui- 없이 올린다
scenarios/ui-*.json
# 그 상황으로 돌린 가상 예시 값의 실행 폴더 (<시각>-ui-<…>). 상황 파일이 없으면 형식 검사가 막는다 (11-16)
engine/samples/runs/*-ui-*/

# 운영체제·편집기
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# AI 도구의 개인 상태
.omc/
.claude/settings.local.json

# 생성물 (Python + uv)
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
